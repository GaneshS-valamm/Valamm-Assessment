# Copy to .env and fill in real values.  Do not commit .env.

# ---- Database -------------------------------------------------------------
# Blank = SQLite fallback at backend/assessment.db (no install needed).
# PostgreSQL (preferred), e.g. Render:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.oregon-postgres.render.com/DBNAME?sslmode=require
# Local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assessment_db
DATABASE_URL=

# ---- Admin account --------------------------------------------------------
ADMIN_USER_ID=admin
# Generate with:
#   python -c "import bcrypt;print(bcrypt.hashpw(b'YourPassword',bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=
# Dev convenience only: if ADMIN_PASSWORD_HASH is empty this plaintext is hashed at startup.
ADMIN_PASSWORD=

# ---- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
# Optional - HS256 is the default and does not need setting.
JWT_ALGORITHM=HS256

# ---- URLs -----------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Defaults -------------------------------------------------------------
DEFAULT_DURATION_MINUTES=60
DISPLAY_TIMEZONE=Asia/Kolkata

# ---- Resume uploads ------------------------------------------------------
# Storage provider is pluggable. "local" writes to RESUME_STORAGE_DIR, which sits
# outside the frontend so uploads are never publicly served. Swap for s3/supabase
# later by implementing ResumeStorage in backend/app/services/storage_service.py.
# Local disk is NOT durable on ephemeral hosts - use object storage in production.
RESUME_STORAGE_BACKEND=local
# Relative paths resolve against the backend directory - fine locally.
# On Render this MUST be an absolute path inside the persistent disk's mount path:
# for a disk mounted at /app/storage, set RESUME_STORAGE_DIR=/app/storage and files land
# at /app/storage/resumes/YYYY/MM/... (storage keys already start with "resumes/").
# Left relative there, uploads land on the container filesystem and are wiped on deploy.
RESUME_STORAGE_DIR=storage/resumes
MAX_RESUME_SIZE_MB=10
RESUME_REQUIRED_BEFORE_START=true

# ---- Frontend (read by Vite) ---------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
